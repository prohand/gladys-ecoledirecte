{
  "manifest_version": 1,
  "type": "device",
  "name": "EcoleDirecte",
  "description": {
    "en": "Grades, homework, timetable, absences and messages from EcoleDirecte in Gladys.",
    "fr": "Notes, devoirs, emploi du temps, absences et messages EcoleDirecte dans Gladys.",
    "de": "Noten, Hausaufgaben, Stundenplan, Fehlzeiten und Nachrichten von EcoleDirecte.",
    "es": "Notas, deberes, horario, ausencias y mensajes de EcoleDirecte en Gladys."
  },
  "version": "1.1.0",
  "docker_image": "ghcr.io/prohand/gladys-ecoledirecte:1.1.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-ecoledirecte/main/cover.png",
  "categories": ["services", "notifications"],
  "keywords": [
    "ecole directe",
    "école directe",
    "vie scolaire",
    "aplim",
    "collège",
    "lycée",
    "cahier de texte",
    "bulletin",
    "carnet de correspondance",
    "school"
  ],
  "countries": ["FR"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "Use the username and password you type on ecoledirecte.com (a parent or a student account). The first time, EcoleDirecte may ask a security question: answer it with the two buttons below the form. Each child then appears in the Discovery tab.",
        "fr": "Utilisez l'identifiant et le mot de passe que vous tapez sur ecoledirecte.com (compte parent ou élève). La première fois, EcoleDirecte peut poser une question de sécurité : répondez-y avec les deux boutons sous le formulaire. Chaque enfant apparaît ensuite dans l'onglet Découverte.",
        "de": "Verwende den Benutzernamen und das Passwort, die du auf ecoledirecte.com eingibst (Eltern- oder Schülerkonto). Beim ersten Mal kann EcoleDirecte eine Sicherheitsfrage stellen: Beantworte sie mit den beiden Schaltflächen unter dem Formular. Jedes Kind erscheint dann im Reiter „Erkennung“.",
        "es": "Use el usuario y la contraseña que escribe en ecoledirecte.com (cuenta de padres o de alumno). La primera vez, EcoleDirecte puede hacer una pregunta de seguridad: respóndala con los dos botones bajo el formulario. Cada hijo aparece luego en la pestaña Descubrimiento."
      },
      "links": [
        {
          "url": "https://www.ecoledirecte.com",
          "label": {
            "en": "EcoleDirecte",
            "fr": "EcoleDirecte",
            "de": "EcoleDirecte",
            "es": "EcoleDirecte"
          }
        },
        {
          "url": "https://github.com/prohand/gladys-ecoledirecte/blob/main/docs/en.md",
          "label": {
            "en": "Integration documentation",
            "fr": "Documentation de l'intégration",
            "de": "Dokumentation der Integration",
            "es": "Documentación de la integración"
          }
        }
      ]
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "Username",
        "fr": "Identifiant",
        "de": "Benutzername",
        "es": "Usuario"
      },
      "description": {
        "en": "Your EcoleDirecte username.",
        "fr": "Votre identifiant EcoleDirecte.",
        "de": "Dein EcoleDirecte-Benutzername.",
        "es": "Su usuario de EcoleDirecte."
      },
      "placeholder": {
        "en": "e.g. jdupont",
        "fr": "ex. jdupont",
        "de": "z. B. jdupont",
        "es": "p. ej. jdupont"
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "description": {
        "en": "Your EcoleDirecte password. It is only sent to EcoleDirecte, never logged.",
        "fr": "Votre mot de passe EcoleDirecte. Il n'est envoyé qu'à EcoleDirecte, jamais écrit dans les logs.",
        "de": "Dein EcoleDirecte-Passwort. Es wird nur an EcoleDirecte gesendet und nie protokolliert.",
        "es": "Su contraseña de EcoleDirecte. Solo se envía a EcoleDirecte y nunca se registra."
      },
      "required": true
    },
    {
      "key": "refresh_minutes",
      "type": "number",
      "label": {
        "en": "Refresh interval (min)",
        "fr": "Intervalle de rafraîchissement (min)",
        "de": "Aktualisierungsintervall (Min.)",
        "es": "Intervalo de actualización (min)"
      },
      "description": {
        "en": "How often EcoleDirecte is read, in minutes (10 to 720).",
        "fr": "Fréquence de lecture d'EcoleDirecte, en minutes (10 à 720).",
        "de": "Wie oft EcoleDirecte gelesen wird, in Minuten (10 bis 720).",
        "es": "Cada cuánto se lee EcoleDirecte, en minutos (10 a 720)."
      },
      "required": false,
      "default": 30,
      "min": 10,
      "max": 720
    },
    {
      "key": "timezone",
      "type": "string",
      "label": {
        "en": "School time zone",
        "fr": "Fuseau horaire de l'établissement",
        "de": "Zeitzone der Schule",
        "es": "Zona horaria del centro"
      },
      "description": {
        "en": "Used for \"today\", \"tomorrow\" and the lesson hours. Change it only for a school outside mainland France, e.g. America/Martinique.",
        "fr": "Sert pour « aujourd'hui », « demain » et les heures de cours. À changer seulement pour un établissement hors métropole, ex. America/Martinique.",
        "de": "Wird für „heute“, „morgen“ und die Unterrichtszeiten verwendet. Nur für eine Schule außerhalb des französischen Festlands ändern, z. B. America/Martinique.",
        "es": "Se usa para «hoy», «mañana» y las horas de clase. Cámbiela solo para un centro fuera de la Francia metropolitana, p. ej. America/Martinique."
      },
      "placeholder": {
        "en": "Europe/Paris",
        "fr": "Europe/Paris",
        "de": "Europe/Paris",
        "es": "Europe/Paris"
      },
      "required": false,
      "default": "Europe/Paris"
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the device names",
        "fr": "Langue des noms d'appareils",
        "de": "Sprache der Gerätenamen",
        "es": "Idioma de los nombres de dispositivos"
      },
      "description": {
        "en": "Language of the feature names written when a student's device is created.",
        "fr": "Langue des noms de fonctionnalités écrits à la création de l'appareil d'un élève.",
        "de": "Sprache der Funktionsnamen, die beim Anlegen des Geräts eines Schülers geschrieben werden.",
        "es": "Idioma de los nombres de funciones escritos al crear el dispositivo de un alumno."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
